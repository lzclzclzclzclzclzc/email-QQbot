# 先完成邮箱验证和 QQ 绑定，再启用收件与发信。
MAIL_LIVE=0
MAIL_USER=
MAIL_PASSWORD=

# 填邮箱服务商提供的主机名。163 可留空并使用原有默认值。
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_IMAP_SECURITY=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_SECURITY=

# 端口 143（IMAP）和 587/25（SMTP）默认使用 STARTTLS，其余默认使用 TLS。
# 如 IMAP 和 SMTP 账号或密码不同，可分别填写。
# MAIL_IMAP_USER=
# MAIL_IMAP_PASSWORD=
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# OAuth2 可填访问令牌，或填访问令牌文件的绝对路径（权限 600）。
# MAIL_ACCESS_TOKEN=
# MAIL_ACCESS_TOKEN_FILE=
# MAIL_IMAP_ACCESS_TOKEN=
# MAIL_IMAP_ACCESS_TOKEN_FILE=
# MAIL_SMTP_ACCESS_TOKEN=
# MAIL_SMTP_ACCESS_TOKEN_FILE=
# 仅在服务商不会自动保存已发送副本时填写实际目录。
MAIL_SENT_FOLDER=

QQBOT_APPID=
QQBOT_SECRET=
QQ_OWNER_OPENID=
# 首次绑定使用 openssl rand -hex 16 生成的随机码，绑定后清空。
QQ_ENROLL_CODE=

DEEPSEEK_API_KEY=
# 如需覆盖 DSH Web profile 的模型，可同时填写下面两项。
# DSH_MAIL_MODEL_PROVIDER=deepseek-official
# DSH_MAIL_MODEL_NAME=deepseek-flash
