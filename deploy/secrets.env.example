# 从 MAIL_LIVE=0 开始。完成 verify、绑定与模型配置后再启用。
MAIL_LIVE=0
MAIL_USER=
MAIL_AUTH_CODE=
QQBOT_APPID=
QQBOT_SECRET=
QQ_OWNER_OPENID=
# 初次绑定时使用 openssl rand -hex 16 生成的值，绑定后清空。
QQ_ENROLL_CODE=
# DeepSeek API 模型使用此 Key。也可配置独立 DSH Web profile 中的模型。
DEEPSEEK_API_KEY=
# 如需覆盖 Web 默认模型，两项同时填写。
DSH_MAIL_MODEL_PROVIDER=
DSH_MAIL_MODEL_NAME=
DSH_MAIL_MODEL_CALLS_DAILY=1000
# 真实 SMTP 验证后确认一旦需要 APPEND 再填写实测目录。
MAIL_SENT_FOLDER=
